fn add_u8(a: encrypted<u8>, b: encrypted<u8>) -> encrypted<u8> {
    return a + b;
}

fn sub_u8(a: encrypted<u8>, b: encrypted<u8>) -> encrypted<u8> {
    return a - b;
}

fn mul_u8(a: encrypted<u8>, b: encrypted<u8>) -> encrypted<u8> {
    return a * b;
}

fn gt_u8(a: encrypted<u8>, b: encrypted<u8>) -> encrypted<bool> {
    return a > b;
}

fn max_u8(a: encrypted<u8>, b: encrypted<u8>) -> encrypted<u8> {
    return if a > b { a } else { b };
}

fn repeated_u8(a: encrypted<u8>, b: encrypted<u8>) -> encrypted<u8> {
    let left = a * b;
    let right = a * b;
    return left + right;
}

