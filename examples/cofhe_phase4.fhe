fn add_u64(a: encrypted<u64>, b: encrypted<u64>) -> encrypted<u64> {
    return a + b;
}

fn sub_u64(a: encrypted<u64>, b: encrypted<u64>) -> encrypted<u64> {
    return a - b;
}

fn mul_u64(a: encrypted<u64>, b: encrypted<u64>) -> encrypted<u64> {
    return a * b;
}

fn gt_u64(a: encrypted<u64>, b: encrypted<u64>) -> encrypted<bool> {
