    let right = a * b;
    return left + right;
}

fn twice_u8(a: encrypted<u8>) -> encrypted<u8> {
    return a + a;
}

fn four_times_u8(a: encrypted<u8>) -> encrypted<u8> {
    let doubled = twice_u8(a);
    return twice_u8(doubled);
}
